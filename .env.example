# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# --- LLM extraction (required, server-side only) ---
ANTHROPIC_API_KEY=sk-ant-xxxx
# optional, defaults to claude-sonnet-4-6
ORBIT_MODEL=claude-sonnet-4-6

# --- Overnight close-out cron (required in production, v1.16) ---
# Any long random string; Vercel Cron sends it as a bearer token to /api/cron/process-elapsed-meetings
CRON_SECRET=generate-a-long-random-string
